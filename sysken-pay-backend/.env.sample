# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=sysken_pay
MYSQL_TZ=Asia/Tokyo

# --- API ---
PORT=8080
# API をどこから届くようにするか。既定は 127.0.0.1（ラズパイの中だけ）。
# フロントを別の PC で動かすときだけ 0.0.0.0 にする
# API_BIND_ADDR=127.0.0.1

ADMIN_USER=admin
ADMIN_PASSWORD=
CHARGE_PASSWORD=

# CORS で許可するフロントの配信元（カンマ区切り）。未設定なら localhost:5173 / localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000
