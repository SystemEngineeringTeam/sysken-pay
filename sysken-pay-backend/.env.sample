# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=sysken_pay
MYSQL_TZ=Asia/Tokyo

# --- API ---
PORT=8080
# API をどこから届くようにするか。既定は 127.0.0.1（ラズパイの中だけ）。
# フロントを別の PC で動かすときだけ 0.0.0.0 にする
# API_BIND_ADDR=127.0.0.1

# 管理者・チャージ画面のパスワード（BASIC 認証）。未設定だと管理系 API はすべて拒否される
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# CORS で許可するフロントの配信元（カンマ区切り）。未設定なら localhost:5173 / localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000

# スマホ登録の QR に入れる URL の頭（部室の Wi-Fi から届くラズパイの入口）。例: http://<ラズパイの IP アドレス>:8081
# IP アドレスはリポジトリに書かず、ここで設定する。未設定だとスマホ登録の QR は作れない
# PUBLIC_BASE_URL=

# 支払い用バーコードを受け取るページの入口をどこから届くようにするか。既定は 127.0.0.1（ラズパイの中だけ）。
# ラズパイでは 0.0.0.0 にして、部室の Wi-Fi のスマホから開けるようにする（開くのはこのページだけ）
# CLAIM_BIND_ADDR=127.0.0.1
# 入口のポート（ラズパイ側）。変えたら PUBLIC_BASE_URL のポートも合わせる
# CLAIM_PORT=8081
