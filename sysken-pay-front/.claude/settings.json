{
  "autoCompactWindow": 150000,
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm generate:api *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm outdated *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python3 ../.claude/hooks/test_deny_dangerous_bash.py)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash clear:*)",
      "Bash(git stash drop:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/../.claude/hooks/deny_dangerous_bash.py\""
          }
        ]
      }
    ]
  }
}
